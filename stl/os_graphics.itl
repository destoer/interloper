// todo: can we assume lat1 is the first keyset?
func x_key_code_to_sym(win: OSWindow@, keycode: u8) u8
{
    return win.key_code_to_sym[keycode];
}

func x_key_event(std_win: Window@, keycode: u8, down: bool)
{
    input::set_input(&std_win.input,keycode,down);
}


func shm_completion(win: OSWindow@, completion: const XSHMCompletion@)
{
    for @image in win.shm_image
    {
        if image.shm_seg == completion.shm_seg
        {
            image.locked = false;
            return;
        }
    }
}

#attr(no_reorder)
struct InputEvent
{
    code: u8;
    detail: u8;
    seq: u16;
    timestamp: u32;
    window_root: u32;
    window_event: u32;
    window_child: u32;
    root_x: s16;
    root_y: s16;
    event_x: s16;
    event_y: s16;
    set_of_key: u16;
    same_screen: bool;
    pad: u8;
}

type_alias MotionNotify = InputEvent; 
type_alias ButtonPress = InputEvent; 
type_alias ButtonRelease = InputEvent; 

func os_end_frame(std_win: Window@) 
{
    std_win.os_win.first_in_frame = true;
}

#attr(no_reorder)
struct GenericEvent
{
    opcode: u8 = 35;
    extension: u8;
    seq_number: u16;
    length: u32;
    event_type: u16;
}

#attr(no_reorder)
struct RawInputEvent
{
    generic: GenericEvent;
    device_id: u16;
    timestamp: u32;
    detail: u32;
    source_id: u16;
    valuators_len: u16;
    flags: u32;
    pad: u32;
}


enum raw_input_event: u16
{
    raw_motion = 17
}

#attr(no_reorder)
struct XFixedPoint32
{
    integral: s32;
    fraction: u32;
}

func handle_xinput_event(std_win: Window@, buffer: std::Array)
{
    event := std::read_var$<gfx::RawInputEvent>(buffer,0);
    input_event := cast(raw_input_event,event.generic.event_type);

    switch(input_event)
    {
        case raw_input_event::raw_motion:
        {
            // TODO: This is making assumptions about the mask
            axis_offset := buffer.buf.len - (sizeof_type(XFixedPoint32) * 2);

            x_fixed := std::read_var$<gfx::XFixedPoint32>(buffer,axis_offset);
            y_fixed := std::read_var$<gfx::XFixedPoint32>(buffer,axis_offset + sizeof(x_fixed));

            std_win.pointer_change.x -= x_fixed.integral;
            std_win.pointer_change.y -= y_fixed.integral;
        }
    }
}

func handle_generic_event(std_win: Window@, buffer: std::Array, generic_event: GenericEvent)
{
    if(generic_event.extension == std_win.os_win.xinput.code)
    {
        handle_xinput_event(std_win,buffer);
    }
}

func os_process_events(std_win: Window@) win_result
{
    win := &std_win.os_win;

    if(!net::socket_valid(&win.sock))
    {
        std_win.quit = true;
        return win_result::closed;
    }

    // while socket has data or we are waiting for specific notification
    while(net::socket_has_data(&win.sock) && !std_win.quit)
    {
        // TODO: we probably want to peek this...
        res := net::recv_clear_array(&win.sock,&win.packet,32);

        if(res != net_result::ok)
        {
            return net_res_to_win(res);
        }

        type := std::read_var$<gfx::x_reply_type>(win.packet,0);

        switch(type)
        {
            case x_reply_type::error:
            {
                return win_result::ok;
            }

            case x_reply_type::reply:
            {
                return process_reply(win);
            }

            case x_reply_type::key_press:
            {
                key := std::read_var$<u8>(win.packet,1);
                x_key_event(std_win,key,true);
            }

            case x_reply_type::key_release:
            {
                key := std::read_var$<u8>(win.packet,1);
                x_key_event(std_win,key,false);         
            }

            case x_reply_type::generic_event:
            {
                event := std::read_var$<gfx::GenericEvent>(win.packet,0);

                res = net::recv_array_all(&win.sock,&win.packet,event.length * 4);
                if(res != net_result::ok)
                {
                    return net_res_to_win(res);
                }

                handle_generic_event(std_win, win.packet, event);
            }

            case x_reply_type::pointer_motion:
            {
                // Do not bother with these events if we have raw input
                if !win.xinput.enabled
                {
                    motion := std::read_var$<gfx::InputEvent>(win.packet,0);
                    cur: std::Vec2I = {motion.event_x, motion.event_y};
                
                    if(win.first_in_frame)
                    {
                        win.reference_pointer = cur;
                        win.first_in_frame = false;
                    }

                    else
                    {
                        std_win.pointer_change = std::vec2i_sub(win.reference_pointer,cur);
                    }
                }
            }

            case x_reply_type::button_press:
            {
                press := std::read_var$<gfx::InputEvent>(win.packet,0);

                std::println("Button press: {} {}",press.event_x,press.event_y);
            }

            case x_reply_type::leave_notify:
            {
                return net_res_to_win(ungrab_pointer(win));
            }

            case x_reply_type::enter_notify:
            {
                return net_res_to_win(grab_pointer(win));
            }

            case x_reply_type::configure_notify:
            {
                config: XConfigureNotify = {?};
                std::read_buffer(win.packet,0,&config,sizeof_data(XConfigureNotify));


                win_res := os_window_resized(std_win,config.width,config.height);

                if win_res != win_result::ok
                {
                    return win_res;
                }

                window_resized(std_win,win.win_x,win.win_y);
            }

            case x_reply_type::shm_completion:
            {
                completion: XSHMCompletion = {?};
                std::read_buffer(win.packet,0,&completion,sizeof_data(XSHMCompletion));
                shm_completion(win,&completion);
            }
        
            case x_reply_type::map_notify:
            {
                win.window_mapped = true;
            }

            default:
            {
                log::debug(X11_PREFIX,"Notify: {}",cast(u8,type));
            }
        }
    }

    return win_result::ok;
}


#attr(no_reorder)
struct XCreateWindow
{
    opcode : u8 = 1;
    depth : u8;
    req_len : u16 = 8;
    window : u32;
    parent : u32;
    x : s16;
    y : s16;
    width : u16;
    height : u16;
    border_width : u16;
    class : u16;
    visual_id : u32;
    value_mask : u32;
}

func create_window(win : OSWindow@, x : u32, y : u32) net_result
{
    win.reply_callback = std::make_hash_table(u32.size,ReplyCallback.size,&std::hash_u32,&std::hash_cmp_mem);

    // allocate a an id and save it
    win.window_id = alloc_resource(win);

    log::debug(X11_PREFIX,"window id: {} {}",win.window_id,win.root_win);

    // build end list
    packet := &win.packet;
    std::clear_array(packet);

    // first the events we want to listen for
    events : u32 = event_flag::structure_notify;
    events |= event_flag::key_release | event_flag::key_press | event_flag::pointer_motion; 
    events |= event_flag::enter_window | event_flag::leave_window;
    std::push_u32(packet,events);

    // attempt to get a rgba window
    win_req : XCreateWindow;
    win_req.req_len += x11_req_len(packet.buf.len);

    // rgb888
    win_req.depth = 24;

    win_req.window = win.window_id;

    win_req.class = WINDOW_CLASS_INPUT_OUTPUT;

    // set root as parent
    win_req.parent = win.root_win;

    win_req.x = cast(s16,win.screen_x / 2);
    win_req.y = cast(s16,win.screen_y / 2);

    
    win_req.width = cast(u16,x);
    win_req.height = cast(u16,y);

    // TODO: dont know how large this should be
    // but we want visual confirmation
    win_req.border_width = 20;

    // TODO: override_redirect can give us a borderless window

    // mark what window settings we want to change
    win_req.value_mask |= window_create_flag::event_mask;
    
    // send the main request
    [_, res] := send_req(win,&win_req,sizeof_data(XCreateWindow));

    if(res != net_result::ok)
    {
        return res;
    }

    // send end list
    res = net::send_array_all(&win.sock,packet); 
    if(res != net_result::ok)
    {
        return res;
    }

    // now map in the window
    return map_window(win,win.window_id);
}

#attr(no_reorder)
struct XCreateGC
{
    opcode: u8 = 55;
    pad1: u8;
    len: u16 = 4;
    cid: u32;
    drawable: u32;
    value_mask: u32;
}

func create_gfx_ctx(win: OSWindow@) net_result
{
    // reserve id for gfx ctx
    win.gfx_ctx = alloc_resource(win);

    gc: XCreateGC;

    gc.cid = win.gfx_ctx;
    gc.drawable = win.window_id;

    [_, res] := send_req(win,&gc,sizeof_data(XCreateGC));
    return res;
}


func update_max_lines(win: OSWindow@)
{
    // what is the max number of lines we can push in one go?
    win.max_lines = win.max_req / (win.win_x * cast(u32,sizeof_type(u32)));

    log::debug(X11_PREFIX,"max lines: {}",win.max_lines);
}

#attr(no_reorder)
struct XSHMDetach
{
    req: u8;	/* always ShmReqCode */
    shm_req: u8 = 2;
    length: u16 = 2;
    shm_seg: u32;
};

func detach_shm(std_win: Window@, image: ShmImage@) net_result
{
    win := &std_win.os_win;

    if image.shm_id < 0
    {
        return net_result::ok;
    }

    shm_detatch: XSHMDetach;
    shm_detatch.req = win.mit_shm.code;
    shm_detatch.shm_seg = image.shm_seg;

    [_, res] := send_req(win,&shm_detatch,sizeof_data(XSHMDetach));

    log::debug(X11_PREFIX,"Detached shm resource: {}",image.shm_seg);

    image.shm_seg = 0;


    if std::shm_ctl(image.shm_id,std::IPC_RMID,NULL) < 0
    {
        log::error(X11_PREFIX,"Failed to destroy shm {}",image.shm_id);
        return net_result::err;
    }

    if std::shm_dt(image.addr) < 0
    {
        log::error(X11_PREFIX,"Failed to detach shm {}",image.shm_id);
        return net_result::err;
    }

    image.locked = false;
    image.shm_id = -1;

    return res;
}

func setup_window_shm(std_win : Window@) win_result
{
    win := &std_win.os_win;

    for @image in win.shm_image
    {
        res := attach_shm(std_win, image);

        if(res != net_result::ok)
        {
            return net_res_to_win(res);
        }
    }

    screen_set_shm(std_win,0);

    return win_result::ok;
}

func os_window_resized(std_win: Window@,x : u32, y: u32) win_result
{
    win := &std_win.os_win;

    win.win_x = x;
    win.win_y = y;

    // Re centre the mouse pointer
    res := warp_pointer(&std_win.os_win,x / 2, y /2);

    if res != net_result::ok
    {
        return net_res_to_win(res);
    }

    update_max_lines(win);

    if win.mit_shm.enabled 
    {
        // This already has the correct allocation just set the size
        for @image in win.shm_image
        {
            image.size = win.win_x * win.win_y;
        }

        screen_set_shm(std_win,win.shm_image_idx);
    }
    
    else
    {
        std::realloc_array_heap(&itl_context.heap,&std_win.screen,x * y);

        // should be able to push atleast one scanline in a go
        std::assert(win.max_lines >= 1);
    }


    return win_result::ok;
}


constant X11_CHANGE_PROPERTY : u8 = 0;

#attr(no_reorder)
struct XChangeProperty
{
    opcode: u8 = 18;
    mode: u8 = X11_CHANGE_PROPERTY;
    len: u16 = 6;
    window: u32;
    property: u32;
    type: u32;
    format: u8;
    pad1: u8[3];
    data_len: u32;
};



constant XA_WM_ICON_NAME: u32 = 37;
constant XA_WM_NAME: u32 = 39;
constant STRING_TYPE : u32 = 31;

func x11_set_str_property(win: OSWindow@, property: u32,str: const string) net_result
{
    prop : XChangeProperty;
    prop.window = win.window_id;
    prop.property = property;
    prop.type = STRING_TYPE;
    prop.format = 8;

    prop.data_len = cast(u32,str.len);

    pad := pad_x11(prop.data_len);
    bytes := x11_req_len(pad + str.len);
    prop.len += bytes;

    [_, res] := send_req(win,&prop,sizeof_data(XChangeProperty));
    if(res != net_result::ok)
    {
        return res;
    }

    res = net::send_str_all(&win.sock,str);
    if(res != net_result::ok)
    {
        return res;
    }

    // just send struct as padding
    return net::send_raw_all(&win.sock,&prop,pad);
}

func os_set_window_name(win: OSWindow@, str: const string) net_result
{
    res := x11_set_str_property(win,XA_WM_NAME,str);
    if(res != net_result::ok)
    {
        return res;
    }

    res = x11_set_str_property(win,XA_WM_ICON_NAME,str);

    log::debug(X11_PREFIX,"change window name: {}",str);
    
    return res;
}

func wait_for_reply(std_win: Window@, done: bool@) win_result
{
    while(!@done && !std_win.quit)
    {
        res := process_events(std_win);
        if(res != win_result::ok)
        {
            log::error(X11_PREFIX,"Error processing events while waiting for reply");
            return res;
        }       
    }

    return win_result::ok;
}

#attr(no_reorder)
struct XQueryExtension
{
    opcode: u8 = 98;
    pad1: u8;
    len: u16 = 2;
    str_len: u16;
    pad2: u16;
}

struct ExtensionQuery
{
    replied: bool;
    opcode: u8;
    enabled: bool;
}

func ext_query_callback(win: OSWindow@, _len: u32, data: byte?) win_result
{
    ext_query := cast(ExtensionQuery@,data);
    ext_query.replied = true;
    ext_query.enabled = cast(bool,std::read_var$<u8>(win.packet,8));
    ext_query.opcode = std::read_var$<u8>(win.packet,9);

    return win_result::ok;
}

func query_extension(std_win: Window@, str: const string) [ExtensionQuery, net_result]
{
    win := &std_win.os_win;

    query : XQueryExtension;

    query.str_len = cast(u16,str.len);

    pad := pad_x11(query.str_len);
    bytes := x11_req_len(pad + str.len);
    query.len += bytes;

    query_reply: ExtensionQuery;

    [ext_query_seq, res] := send_req(win,&query,sizeof_data(XQueryExtension));
    if(res != net_result::ok)
    {
        return query_reply, res;
    }

    res = net::send_str_all(&win.sock,str);
    if(res != net_result::ok)
    {
        return  query_reply, res;
    }

    // just send struct as padding
    res = net::send_raw_all(&win.sock,&query,pad);

    if(res != net_result::ok)
    {
        return query_reply, res;
    }

    callback: ReplyCallback = {&ext_query_callback,&query_reply};
    add_reply_callback(win,ext_query_seq,&callback);

    reply_res := wait_for_reply(std_win,&query_reply.replied);

    if(reply_res != win_result::ok)
    {
        res = net_result::err;
    }

    return query_reply, res;
}

#attr(no_reorder)
struct XBigReqEnable
{
    opcode: u8;
    req_op: u8 = 0;
    len: u16 = 1;
}

struct XBigReqReply
{
    replied: bool;
    max_req: u32;
}

func enable_big_req_callback(win: OSWindow@, _len: u32, data: byte?) win_result
{
    reply := cast(XBigReqReply@,data);

    reply.replied = true;
    reply.max_req = std::read_var$<u32>(win.packet,8) * 4;

    return win_result::ok;
}

func enable_big_req(std_win: Window@) net_result
{
    win := &std_win.os_win;
    res := enable_extension(std_win,"BIG-REQUESTS",&win.big_req);    

    if(res != net_result::ok || !win.big_req.enabled)
    {
        return res;
    }

    enable: XBigReqEnable;
    enable.opcode = win.big_req.code;

    // send the opcode
    [big_req_seq, res] := send_req(win,&enable,sizeof_data(XBigReqEnable));
    if(res == net_result::err)
    {
        return res;
    }

    query_reply: XBigReqReply;
    callback: ReplyCallback = {&enable_big_req_callback,&query_reply};
    add_reply_callback(win,big_req_seq,&callback);

    reply_res := wait_for_reply(std_win,&query_reply.replied);
    if(reply_res != win_result::ok)
    {
        return net_result::err;
    }

    win.max_req = query_reply.max_req;

    update_max_lines(win);

    return net_result::ok;
}

#attr(no_reorder)
struct XGrabKey
{
    opcode: u8 = 33;
    owner_events: bool;
    req_len: u16 = 4;
    window: u32;
    mask: u16;
    keycode: u8;
    pointer_mode: u8;
    keyboard_mode: u8;
    pad1: u8[3];
}

enum event_sync : u8 
{
    sync = 0,
    async = 1,
}

func grab_keyboard(win: OSWindow@) net_result
{
    grab: XGrabKey;

    grab.window = win.window_id;
    grab.keyboard_mode = event_sync::async;
    grab.pointer_mode = event_sync::async;

    // grab any key
    grab.mask = 0x8000;

    [_, res] := send_req(win,&grab,sizeof_data(XGrabKey));
    return res;
}

#attr(no_reorder)
struct XGetKeyboardMapping
{
    opcode: u8 = 101;
    pad1: u8;
    len: u16 = 2;
    first_keycode: u8;
    count: u8;
    pad2: u16;
}

func keyboard_mapping_callback(win: OSWindow@, len: u32, data: byte?) win_result
{
    replied := cast(bool@,data);
    @replied = true;

    log::debug(X11_PREFIX,"Key mapping setup");
    n := std::read_var$<u8>(win.packet,1);

    res := read_x11_reply(win,len);
    if(res != net_result::err)
    {
        return net_res_to_win(res);
    }
    
    cur : u32 = 0;
    offset := n * 4;

    for(i in win.min_keycode < win.max_keycode)
    {
        win.key_code_to_sym[i] = std::read_var$<u8>(win.packet,cur);
        cur += offset;
    }
    
    return win_result::ok;
}

func get_keyboard_mapping(std_win: Window@) win_result
{
    win := &std_win.os_win;

    map: XGetKeyboardMapping;
    map.first_keycode = win.min_keycode;
    map.count = win.max_keycode - map.first_keycode;

    [get_key_map_seq, res] := send_req(win,&map,sizeof_data(XGetKeyboardMapping));

    if(res != net_result::ok)
    {
        return net_res_to_win(res);
    }

    replied: bool;

    callback: ReplyCallback = {&keyboard_mapping_callback,&replied};
    add_reply_callback(win,get_key_map_seq,&callback);

    return wait_for_reply(std_win,&replied);
}

#attr(no_reorder)
struct XGrabButton
{
    opcode: u8 = 28;
    owner_events: bool;
    request_length: u16 = 6;
    window: u32;
    set_of_pointer_events: u16;
    pointer_mode: u8;
    keyboard_mode: u8;
    confine_to: u32;
    cursor: u32;
    button: u8;
    pad1: u8;
    set_of_key_mask: u16;
}

func grab_button(win: OSWindow@) net_result
{
    grab: XGrabButton;

    grab.window = win.window_id;
    grab.set_of_pointer_events = 0x100 | 0x200 | 0x4 | 0x8;
    grab.pointer_mode = event_sync::async;
    grab.keyboard_mode = event_sync::async;
    grab.set_of_key_mask = 0x8000;

    [_, res] := send_req(win,&grab,sizeof_data(XGrabButton));
    return res;
}

#attr(no_reorder)
struct XGrabPointer
{
    opcode: u8 = 26;
    owner_events: bool;
    request_length: u16 = 6;
    window: u32;
    set_of_pointer_events: u16;
    pointer_mode: u8;
    keyboard_mode: u8;
    confine_to: u32;
    cursor: u32;
    timestamp: u32;
}

func grab_pointer(win: OSWindow@) net_result
{
    grab: XGrabPointer;

    grab.window = win.window_id;
    grab.keyboard_mode = 1;
    grab.pointer_mode = 1;
    grab.confine_to = win.window_id;
    // Motion | leave | enter
    grab.set_of_pointer_events = 0x40 | 0x20 | 0x10;

    [_, res] := send_req(win,&grab,sizeof_data(XGrabPointer));
    return res;
}

#attr(no_reorder)
struct XUngrabPointer
{
    opcode: u8 = 27;
    pad: u8;
    request_length: u16 = 2;
    timestamp: u32;
}

func ungrab_pointer(win: OSWindow@) net_result
{
    grab: XUngrabPointer;

    [_, res] := send_req(win,&grab,sizeof_data(XUngrabPointer));
    return res;
}

#attr(no_reorder)
struct XWarpPointer
{
    opcode: u8 = 41;
    pad: u8;
    request_length: u16 = 6;
    src_window: u32;
    dst_window: u32;
    src_x: s16;
    src_y: s16;
    src_width: s16;
    src_height: s16;
    dst_x: s16;
    dst_y: s16;
}

func warp_pointer(win: OSWindow@, x: u32, y: u32) net_result
{
    warp: XWarpPointer;
    warp.src_window = win.window_id;
    warp.dst_window = win.window_id;

    warp.dst_x = cast(s16,x);
    warp.dst_y = cast(s16,y);
    
    [_, res] := send_req(win,&warp,sizeof_data(XWarpPointer));
    return res;
}

#attr(no_reorder)
struct XCreateCursor
{
    opcode: u8 = 93;
    pad: u8;
    request_length: u16 = 8;
    cid: u32;
    source: u32;
    mask: u32;
    foreground_red: u16;
    foreground_green: u16;
    foreground_blue: u16;
    background_red: u16;
    background_green: u16;
    background_blue: u16;
    x: u16;
    y: u16;
}

#attr(no_reorder)
struct XCreatePixmap
{
    opcode: u8 = 53;
    depth: u8;
    request_length: u8 = 4;
    pid: u32;
    drawable: u32;
    width: u16;
    height: u16;
}

func create_pixmap(win: OSWindow@, x: u16, y: u16) [id: u32, res: net_result]
{
    pixmap: XCreatePixmap;
    pixmap.width = x;
    pixmap.height = y;
    pixmap.depth = 1;
    pixmap.pid = alloc_resource(win);
    pixmap.drawable = win.window_id;

    [_, res] := send_req(win,&pixmap,sizeof_data(XCreatePixmap));
    return pixmap.pid, res; 
}

func create_blank_cursor(win: OSWindow@) net_result
{
    cursor: XCreateCursor;
    cursor.x = 0;
    cursor.y = 0;
    [pixmap, res] := create_pixmap(win,1,1);
    if(res != net_result::ok)
    {
        return res;
    }

    cursor.source = pixmap;
    cursor.cid = alloc_resource(win);

    win.blank_cursor = cursor.cid;

    [_, res] := send_req(win,&cursor,sizeof_data(XCreateCursor));
    return res;
}

#attr(no_reorder)
struct XChangeWindowAttributes
{
    opcode: u8 = 2;
    pad: u8;
    request_length: u16 = 3;
    window: u32;
    bitmask: u32;
}

func change_window_attribute(win: OSWindow@, cursor: u32) net_result
{
    packet := &win.packet;
    std::clear_array(packet);

    std::push_u32(packet,cursor);

    change: XChangeWindowAttributes;

    change.bitmask |= window_create_flag::cursor;
    change.request_length += x11_req_len(packet.buf.len);
    change.window = win.window_id;


    [_, res] := send_req(win,&change,sizeof_data(XChangeWindowAttributes));
    if res != net_result::ok
    {
        return res;
    }

    // send end list
    return net::send_array_all(&win.sock,packet); 
}

// For now these have the same members so we can just cheat.
func net_res_to_win(res: net_result) win_result 
{
    raw := cast(u32,res);
    return cast(win_result,raw);
}

#attr(no_reorder)
struct XSHMReqAttach
{
    req: u8;
    req_type: u8 = 1;
    length: u16 = 4;
    shm_seg: u32;
    shm_id: u32;
    read_only: bool;
    pad0: u8;
    pad1: u16;
}

func attach_shm(std_win: Window@, image: ShmImage@) net_result
{
    win := &std_win.os_win;

    // Allocate something screen sized so we dont have to reallocate this
    image.shm_id = std::shm_get(std::IPC_PRIVATE,cast(u32,win.screen_x * win.screen_y  * sizeof_type(u32)),std::IPC_CREATE | 0777);

    if(image.shm_id < 0)
    {
        win.mit_shm.enabled = false;
        return net_result::err;
    }

    image.addr = cast(u32@,std::shm_at(image.shm_id,NULL,0));
    image.size = win.win_x * win.win_y;

    image.shm_seg = alloc_resource(win);

    attach_req: XSHMReqAttach;
    attach_req.req = win.mit_shm.code;
    attach_req.shm_id = cast(u32,image.shm_id);
    attach_req.shm_seg = image.shm_seg;
    attach_req.read_only = true;

    [_, res] := send_req(win,&attach_req,sizeof_data(XSHMReqAttach));

    if(res != net_result::ok)
    {
        return res;
    }

    log::debug(X11_PREFIX,"Attached SHM Resource {}",image.shm_seg);

    return res;
}

func enable_extension(std_win: Window@, name: const string, ext: ExtensionInfo@) net_result
{
    // send ext query
    [ext_query, res] := query_extension(std_win,name);

    if(res != net_result::ok)
    {
        return res;
    }

    ext.code = ext_query.opcode;
    ext.enabled = ext_query.enabled;

    log::debug(X11_PREFIX,"{} SUPPORTED {} {}",name,ext_query.enabled,ext_query.opcode);

    return net_result::ok;    
}

func enable_mit_shm(std_win: Window@) net_result
{
    return enable_extension(std_win,"MIT-SHM",&std_win.os_win.mit_shm);
}

func enable_xinput(std_win: Window@) net_result
{
    return enable_extension(std_win,"XInputExtension",&std_win.os_win.xinput);
}

#attr(no_reorder)
struct XISelectEvents
{
    opcode: u8;
    xinput_opcode: u8 = 46;
    request_length: u16 = 3;
    window: u32;
    num_mask: u16;
    pad: u16;
}

#attr(no_reorder)
struct EventMask
{
    // All devices
    device_id: u16 = 0;
    // Hardcoded for a single mask 
    mask_len: u16 = 1;
    mask: u32;
}


#attr(flag)
enum xi_event_mask : u32
{
    unused_zero,
    device_changed,
    key_press,     
    key_release,   
    button_press,  
    button_release,
    motion,       
    enter,        
    leave,        
    focus_in,      
    focus_out,      
    hierarchy,     
    property,      
    raw_key_press,   
    raw_key_release, 
    raw_button_press,
    raw_button_release,
    raw_motion,     
    touch_begin,    
    touch_update,   
    touch_end,      
    touch_ownership,
    raw_touch_begin, 
    raw_touch_update,
    raw_touch_end,   
    barrier_hit,    
    barrier_heave  
}

func enable_raw_input(std_win: Window@) net_result
{
    win := &std_win.os_win;

    select_events: XISelectEvents;
    select_events.opcode = win.xinput.code;
    select_events.window = win.root_win;
    select_events.num_mask = 1;

    mask: EventMask;
    mask.mask |= xi_event_mask::raw_motion;

    select_events.request_length += x11_req_len(sizeof(mask));

    [_, res] := send_req(win,&select_events,sizeof_data(XISelectEvents));

    if res != net_result::ok
    {
        return res;
    }

    return net::send_raw_all(&win.sock,&mask,sizeof(mask));
}

func os_open_window(std_win: Window@,str : const string, x : u32, y : u32) win_result
{
    win := &std_win.os_win;

    win.win_x = x;
    win.win_y = y;

    socket_name := "/tmp/.X11-unix/X0";
    log::debug(X11_PREFIX,"connecting to {}",socket_name);

    // open connection to x server
    [win.sock, res] := std::connect_unix_domain(socket_name);

    if(res != net_result::ok)
    {
        log::error(X11_PREFIX,"window socket {} not valid",socket_name);
        return net_res_to_win(res);
    }

    res = authenticate(win);
    if(res != net_result::ok)
    {
        log::error(X11_PREFIX,"could not authenticate to server");
        return net_res_to_win(res);
    }

    res = create_window(win,x,y);
    if(res != net_result::ok)
    {
        log::error(X11_PREFIX,"Failed to create window");
        return net_res_to_win(res);
    }


    res = create_gfx_ctx(win);
    if(res != net_result::ok)
    {
        log::error(X11_PREFIX,"Failed to create gfx context");
        return net_res_to_win(res);
    }

    log::info(X11_PREFIX,"waiting for window mapping");

    // wait for window to become mapped
    while(!win.window_mapped)
    {
        win_res := process_events(std_win);
        if(win_res != win_result::ok)
        {
            return win_res;
        }
    }

    res = os_set_window_name(win,str);
    if(res != net_result::ok)
    {
        log::error(X11_PREFIX,"Could not set window name");
        return net_res_to_win(res);
    }

    // try to enable the big request exenstion
    res = enable_big_req(std_win);

    if(res != net_result::ok)
    {
        log::error(X11_PREFIX,"Error enabling big requests");
        return net_res_to_win(res);
    }

    res = enable_mit_shm(std_win);

    if(res != net_result::ok)
    {
        return net_res_to_win(res);
    }

    if(win.mit_shm.enabled)
    {
        std::destroy_array_heap(&itl_context.heap,&std_win.screen);
        win_res := setup_window_shm(std_win);

        if(win_res != win_result::ok)
        {
            return win_res;
        }
    }

    res = enable_xinput(std_win);
    if(res != net_result::ok)
    {
        return net_res_to_win(res);
    }

    if win.xinput.enabled 
    {
        res = enable_raw_input(std_win);

        if res != net_result::ok
        {
            return net_res_to_win(res);
        }
    }

    key_res := get_keyboard_mapping(std_win);

    log::debug(X11_PREFIX,"Acquired keyboard mapping");

    if(key_res != win_result::ok)
    {
        return key_res;
    }

    res = create_blank_cursor(win);
    if(res != net_result::ok)
    {
        return net_res_to_win(res);
    }

    res = change_window_attribute(win,win.blank_cursor);

    return net_res_to_win(res);
}

func os_destroy_window(std_win : Window@) win_result
{
    win := &std_win.os_win;

    defer std::destroy_array(&win.packet);

    if !win.mit_shm.enabled
    {   
        std::destroy_array_heap(&itl_context.heap,&std_win.screen);
    }

    // Socket has already been cut. 
    // Assume this is shut correctly.
    if(!net::socket_valid(&win.sock))
    {
        return win_result::ok;
    }

    // destroy all resources
    res := x11_destroy_window(win,win.window_id);
    if(res != net_result::ok)
    {
        return net_res_to_win(res);
    }


    if win.mit_shm.enabled
    {
        for @image in win.shm_image
        {
            res = detach_shm(std_win,image);

            if(res != net_result::ok)
            {
                return net_res_to_win(res);
            }
        }
    }

    res = net::close_sock(&win.sock);

    return net_res_to_win(res);
}
