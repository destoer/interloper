namespace gfx;

import <socket>

constant X11_PREFIX : const string = "X WINDOW";


type_alias REPLY_CALLBACK_FUNC = func(win: OSWindow@, len: u32, raw_data: byte?) win_result;

struct ReplyCallback
{
    callback: REPLY_CALLBACK_FUNC;
    data: byte?;
};

struct ShmImage
{
    shm_seg: u32;
    shm_id: s32 = -1;
    addr: u32@;
    size: usize;
    locked: bool;
};

struct ExtensionInfo
{
    enabled: bool;
    code: u8;
}

// https://www.x.org/releases/X11R7.5/doc/x11proto/proto.pdf
// https://gitlab.freedesktop.org/xorg/proto/xcbproto/
struct OSWindow
{
    // protocol buffer
    packet : std::Array;
    sock : net::Socket;

    root_win : u32;

    // dimensions
    screen_x : u32;
    screen_y : u32;

    win_x: u32;
    win_y: u32;

    scanline_pad : u32;
    max_req : u32;
    max_lines : u32;

    // window info
    window_id : u32;
    gfx_ctx : u32;

    window_mapped : bool;

    // request info
    seq_count : u32 = 1;

    resource_base : u32;
    resource_mask : u32;
    resource_id: u32;

    // key code
    min_keycode: u8;
    max_keycode: u8;
    key_code_to_sym: u8[255];

    // pointer info
    reference_pointer: std::Vec2I;
    blank_cursor: u32;
    first_in_frame: bool = true;

    big_req: ExtensionInfo;
    mit_shm: ExtensionInfo;
    xinput: ExtensionInfo;

    shm_image_idx: usize;
    shm_image: ShmImage[2];

    reply_callback : std::HashTable;
}

constant WINDOW_CLASS_INPUT_OUTPUT : u16 = 1;

