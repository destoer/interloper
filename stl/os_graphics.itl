}

#attr(no_reorder)
struct XPutImageSHM
{
    req: u8;	
    shm_req: u8 = 3;
    len: u16 = 10;
    drawable: u32;
    gc: u32;
    total_width: u16;
    total_height: u16;
    src_x: u16;
    src_y: u16;
    width: u16;
    height: u16;
    dst_x: s16;
    dst_y: s16;
    depth: u8;
    format: u8 = 2;
    send_event: bool;
    pad1: u8;
    shm_seg: u32;
    offset: u32;
};


func draw_lines(win: OSWindow@, ptr: const u32@, start_y: u32,lines: u32, stride: u32) net_result
{
    // calc data size
    pixel_size := cast(u32,lines * stride * sizeof_type(u32));

    pad := pad_x11(pixel_size);

    bytes := (pixel_size + pad) / 4;

    // we can use the ext send big image req
    if(win.big_req.enabled)
    {
        // send image req
        put_image: XPutImageBig;

        put_image.gc = win.gfx_ctx;
        put_image.depth = 24;

        put_image.dst_y = cast(s16,start_y);

        put_image.width = cast(u16,stride);
        put_image.height = cast(u16,lines);

        put_image.drawable = win.window_id;
    
        put_image.len += bytes;
        

        [_,res] := send_req(win,&put_image,sizeof_data(XPutImageBig));

        if(res != net_result::ok)
        {
            return res;
        }
    }

    // small req
    else
    {
        put_image: XPutImage;

        put_image.gc = win.gfx_ctx;
        put_image.depth = 24;

        put_image.dst_y = cast(s16,start_y);

        put_image.width = cast(u16,stride);
        put_image.height = cast(u16,lines);

        put_image.drawable = win.window_id;
    
        put_image.len += cast(u16,bytes);
        
        [_, res] := send_req(win,&put_image,sizeof_data(XPutImage));
        if(res != net_result::ok)
        {
            return res;
        }
    }

    // send pending data
    res := net::send_raw_all(&win.sock,ptr,pixel_size);
    if(res != net_result::ok)
    {
        return res;
    }

    // send pad 
    // NOTE: uses screen data just because its easy
    return net::send_raw_all(&win.sock,ptr,pad);
}

func render_shm(std_win: Window@) win_result
{
    win := &std_win.os_win;

    shm_image := &win.shm_image[win.shm_image_idx];
    win.shm_image_idx = (win.shm_image_idx + 1) % win.shm_image.len;

    shm_image.locked = true;

    put_image: XPutImageSHM;
    put_image.req = win.mit_shm.code;
 
    put_image.gc = win.gfx_ctx;
    put_image.drawable = win.window_id;
    put_image.depth = 24;

    width := std_win.width;
    height := std_win.height;

    put_image.width = cast(u16, width);
    put_image.height = cast(u16, height);
    put_image.total_width = cast(u16, width);
    put_image.total_height = cast(u16, height);        

    put_image.shm_seg = shm_image.shm_seg;
    put_image.send_event = true;

    [_,res] := send_req(win,&put_image,sizeof_data(XPutImageSHM));

    return net_res_to_win(res);    
}

func screen_set_shm(std_win: Window@, index: usize)
{
    win := &std_win.os_win;

    win.shm_image_idx = index;
    image := &win.shm_image[win.shm_image_idx];

    std_win.screen.data = image.addr;
    std_win.screen.len = image.size;
}

func acquire_shm_image(std_win: Window@) result
{
    win := &std_win.os_win;

    for i in 0 < win.shm_image.len
    {
        image := &win.shm_image[i];

        if(!image.locked)
        {
            screen_set_shm(std_win,i);
            return result::ok;
        }
    }

    return result::err;
}

func unlock_shm_buffer(std_win: Window@) win_result
{
    shm_res := result::err;

    while shm_res != result::ok
    {
        shm_res = acquire_shm_image(std_win);

        if shm_res == result::err
        {
            res := os_process_events(std_win);

            if res != win_result::ok
            {
                return res;
            }
        }
    }

    return win_result::ok;
}

func os_draw_window(std_win: Window@) win_result
{
    win := &std_win.os_win;

    if(win.mit_shm.enabled)
    {   
        res := render_shm(std_win);
        if(res != win_result::ok)
        {
            return res;
        }

        return unlock_shm_buffer(std_win);
    }

    // Render lines manually with several put image calls
    lines := win.max_lines;
    ptr := std_win.screen.data;

    offset := std_win.width * lines;

    for(y : u32 = 0; y < std_win.height; y += lines)
    {
        to_draw := std::min(lines,std_win.height - y);

        res := draw_lines(win,ptr,y,to_draw,std_win.width);

        if(res != net_result::ok)
        {
            return net_res_to_win(res);
        }

        ptr += offset;
    }

    return win_result::ok;
}



